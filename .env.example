# Backend propio (desarrollo local)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Backend desplegado en FastAPI Cloud (entorno de desarrollo)
# EXPO_PUBLIC_API_URL=https://omnibus-tracker.fastapicloud.dev/

# Estilo de mapa MapLibre. Opciones gratuitas sin API key:
# - CARTO Voyager (recomendado para navegación urbana):
EXPO_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
# - OpenFreeMap Liberty (alternativa vectorial libre):
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# API key para consumir endpoints protegidos del backend (generar vía /admin/api-keys).
EXPO_PUBLIC_API_KEY=cambia_por_tu_api_key
