{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://omnibus-tracker.fastapicloud.dev/",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        "EXPO_PUBLIC_API_KEY": "cambia_por_tu_api_key"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://omnibus-tracker.fastapicloud.dev/",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        "EXPO_PUBLIC_API_KEY": "cambia_por_tu_api_key"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://omnibus-tracker.fastapicloud.dev/",
        "EXPO_PUBLIC_MAP_STYLE_URL": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        "EXPO_PUBLIC_API_KEY": "cambia_por_tu_api_key"
      }
    }
  }
}
