# Configuración de desarrollo local (no commitear; ver .env.example)
# Puerto de Metro Bundler (evita colisiones con otros servicios en 8081).
EXPO_PUBLIC_METRO_PORT=8088
# IP LAN de la PC para que el teléfono (misma Wi‑Fi) o adb reverse pueda alcanzar Metro + backend.
EXPO_PUBLIC_HOST=192.168.1.9
# Backend FastAPI desplegado en FastAPI Cloud (entorno de desarrollo).
EXPO_PUBLIC_API_URL=https://omnibus-tracker.fastapicloud.dev/
# Estilo de mapa para desarrollo: CARTO Voyager (gratuito, sin API key).
# Alternativa: https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
# API key para consumir endpoints protegidos del backend (generar vía /admin/api-keys).
EXPO_PUBLIC_API_KEY=cambia_por_tu_api_key
# Estilo de mapa (demo solo para desarrollo; ver BL-009 para producción).
EXPO_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json