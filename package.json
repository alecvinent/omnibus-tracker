{
  "name": "omnibus-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-local-build.ps1",
    "eas:build:development": "eas build --platform android --profile development",
    "eas:build:preview": "eas build --platform android --profile preview",
    "eas:build:production": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.0",
    "expo-dev-client": "~57.0.21",
    "expo-linking": "~57.0.0",
    "expo-location": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.0"
  }
}
