{
  "name": "omnibus-tracker",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/alecvinent/omnibus-tracker.git"
  },
  "main": "expo-router/entry",
  "bin": {
    "omnibus-backlog": "./scripts/backlog-cli.js"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/android-local-build.ps1",
    "eas:build:development": "eas build --platform android --profile development",
    "eas:build:preview": "eas build --platform android --profile preview",
    "eas:build:production": "eas build --platform android --profile production",
    "semantic-release": "semantic-release",
    "semantic-release:dry": "semantic-release --dry-run --branches feature/021-semantic-release"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.0",
    "expo-dev-client": "~57.0.21",
    "expo-linking": "~57.0.0",
    "expo-location": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^30.5.2",
    "semantic-release": "^25.0.9",
    "typescript": "~5.9.0"
  }
}
