# API de transporte público de la IMM (BL-001)
# Registrar una cuenta gratuita en https://api.montevideo.gub.uy/signup
# y crear una aplicación para obtener client_id / client_secret.
# NUNCA committer valores reales: este archivo solo contiene placeholders.
IMM_CLIENT_ID=cambia_por_tu_client_id
IMM_CLIENT_SECRET=cambia_por_tu_client_secret
IMM_TOKEN_URL=https://mvdapi-auth.montevideo.gub.uy/token
IMM_API_BASE_URL=https://api.montevideo.gub.uy/api/transportepublico

# API keys de este backend (BL-030)
ADMIN_API_KEY=cambia_por_tu_admin_key
API_KEYS_DB_PATH=data/api_keys.db

# Geocodificación (BL-006)
NOMINATIM_USER_AGENT=omnibus-tracker/1.0 (contacto: cambia_por_tu_email)
